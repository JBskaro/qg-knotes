@@ -35,6 +38,49 @@

 namespace sherpa_onnx {

+#if defined(_WIN32) && SHERPA_ONNX_ENABLE_DIRECTML == 1
+// DirectML takes an index in EnumAdapters order, not GPU preference order.
+static int32_t DirectMLDeviceIndex() {
+  using Microsoft::WRL::ComPtr;
+  ComPtr<IDXGIFactory1> factory;
+  if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(factory.GetAddressOf())))) {
+    return 0;
+  }
+
+  ComPtr<IDXGIFactory6> preferred_factory;
+  if (FAILED(factory.As(&preferred_factory))) {
+    return 0;
+  }
+
+  for (UINT i = 0;; ++i) {
+    ComPtr<IDXGIAdapter1> preferred;
+    if (FAILED(preferred_factory->EnumAdapterByGpuPreference(
+            i, DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE,
+            IID_PPV_ARGS(preferred.GetAddressOf())))) {
+      return 0;
+    }
+    DXGI_ADAPTER_DESC1 preferred_desc{};
+    if (FAILED(preferred->GetDesc1(&preferred_desc)) ||
+        (preferred_desc.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) {
+      continue;
+    }
+
+    for (UINT index = 0;; ++index) {
+      ComPtr<IDXGIAdapter> adapter;
+      if (FAILED(factory->EnumAdapters(index, adapter.GetAddressOf()))) {
+        break;
+      }
+      DXGI_ADAPTER_DESC desc{};
+      if (SUCCEEDED(adapter->GetDesc(&desc)) &&
+          desc.AdapterLuid.LowPart == preferred_desc.AdapterLuid.LowPart &&
+          desc.AdapterLuid.HighPart == preferred_desc.AdapterLuid.HighPart) {
+        return static_cast<int32_t>(index);
+      }
+    }
+  }
+}
+#endif
